# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only — never expose to the browser, used by the Stripe webhook

# Stripe — Developers > API keys (use TEST keys until you're ready to go live)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRICE_ID=price_...   # the recurring price object for the 49€/month plan
NEXT_PUBLIC_STRIPE_PRICE_ID_ANNUAL=price_...   # the recurring price object for the annual plan (20% off monthly)

# Used to build absolute URLs for Stripe redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic — console.anthropic.com/settings/keys — powers "Chat with Your Data" (/api/chat)
ANTHROPIC_API_KEY=sk-ant-...
